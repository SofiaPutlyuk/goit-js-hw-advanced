<ul>
  {{#each this}}
    <li>
      <h2>{{name}}</h2>
      <p>Вік: {{age}}</p>
      <p>Активний: {{#if isActive}}Так{{else}}Ні{{/if}}</p>
      <p>Email: {{email}}</p>
      <p>Хобі: {{#each hobbies}} {{this}} {{/each}}</p>
      <p>Адреса: {{address.city}}, Поштовий код: {{address.postalCode}}</p>
    </li>
  {{/each}}
</ul>